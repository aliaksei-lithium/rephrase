# Local development: wrangler loads .env (symlink to local.env, holds the Anthropic key) and .env.local (copy of this file). Both are git-ignored.
APP_PASSWORD=choose-a-long-password
# AUTH_SECRET=optional-separate-signing-secret
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY>/anthropic
# AI_GATEWAY_TOKEN=only-for-authenticated-gateways
# Needed when the key is an organization-level key (error: "not scoped to a workspace"). Console > Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
